# ==============================================
# SERVER CONFIGURATION
# ==============================================
PORT=3001
PAYMENT_SERVER_PORT=3002
NODE_ENV=development

# App URL (used for Shopify OAuth redirect_uri — must be whitelisted in Shopify app settings)
APP_URL=http://localhost:3001

# Frontend URL (for CORS and OAuth redirect after callback)
FRONTEND_URL=http://localhost:3000

# Backend URL (used by MCP handler for internal API calls)
BACKEND_URL=http://localhost:3001

# ==============================================
# MONGODB DATABASE
# ==============================================
MONGODB_URI=mongodb://localhost:27017/x402

# ==============================================
# AUTH
# ==============================================
JWT_SECRET=your-secret-key-here

# ==============================================
# WALLET MODE: "caw" (Cobo Agentic Wallet) or "direct" (private key)
# ==============================================
WALLET_MODE=caw

# ==============================================
# COBO AGENTIC WALLET (CAW) — Track 1 Configuration
# Required when WALLET_MODE=caw
# ==============================================
CAW_API_URL=https://api.agenticwallet.cobo.com
CAW_API_KEY=your_caw_api_key_here
CAW_WALLET_UUID=your_wallet_uuid_here
CAW_AGENT_ID=your_agent_id_here
CAW_ETH_ADDRESS=0xYourEthAddressHere
CHAIN=SETH

# Escrow contract address on Sepolia (set after deploying the contract)
ESCROW_CONTRACT_ADDRESS=

# ==============================================
# FALLBACK: DIRECT WALLET (only used when WALLET_MODE=direct)
# 0x-prefixed private key with ETH balance on Ethereum Sepolia
# ==============================================
WALLET_PRIVATE_KEY=
ETH_PRIVATE_KEY=

# ==============================================
# GMI CLOUD — GLM-5.1 AI MODEL
# ==============================================
GMI_API_KEY=your_gmi_api_key_here
GMI_API_URL=https://api.gmicloud.ai/v1

# ==============================================
# ERC-8004 TRUSTLESS IDENTITY (optional)
# Set after first on-chain registration
# ==============================================
ERC8004_AGENT_ID=

# ==============================================
# SHOPIFY OAUTH (optional — not required for hackathon)
# ==============================================
SHOPIFY_API_KEY=placeholder
SHOPIFY_CLIENT_SECRET=placeholder

# ==============================================
# CHAIN / NETWORK
# ==============================================
X402_CHAIN=sepolia
